<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(context.Request.Method == &quot;POST&quot; &amp;&amp; context.Request.Url.Path.Equals(&quot;/api/auth/customer&quot;, StringComparison.OrdinalIgnoreCase))">
        <rate-limit-by-key calls="5" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
      </when>
      <otherwise>
        <validate-jwt header-name="Authorization"
                      failed-validation-httpcode="401"
                      failed-validation-error-message="Unauthorized: a valid customer access token is required."
                      output-token-variable-name="customer-jwt">
          <issuers>
            <issuer>CatCarAuthServer</issuer>
          </issuers>
          <audiences>
            <audience>CatCarApi</audience>
          </audiences>
          <issuer-signing-keys>
            <key>{{catcar-jwt-signing-key}}</key>
          </issuer-signing-keys>
          <required-claims>
            <claim name="role" match="any">
              <value>Customer</value>
            </claim>
            <claim name="customer_id" />
          </required-claims>
        </validate-jwt>
        <rate-limit-by-key calls="60"
                           renewal-period="60"
                           counter-key="@(((Jwt)context.Variables[&quot;customer-jwt&quot;]).Claims[&quot;sub&quot;][0])" />
        <choose>
          <when condition="@(context.Request.Url.Path.StartsWith(&quot;/api/customers/&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; !string.Equals(context.Request.Url.Path.Split('/')[3], ((Jwt)context.Variables[&quot;customer-jwt&quot;]).Claims[&quot;customer_id&quot;][0], StringComparison.OrdinalIgnoreCase))">
            <return-response>
              <set-status code="403" reason="Forbidden" />
              <set-header name="Content-Type" exists-action="override">
                <value>application/problem+json</value>
              </set-header>
              <set-body>{"type":"https://www.rfc-editor.org/rfc/rfc7807#section-3.1","title":"Customer identity mismatch","status":403}</set-body>
            </return-response>
          </when>
          <when condition="@(context.Request.Method == &quot;GET&quot; &amp;&amp; context.Request.Url.Path.StartsWith(&quot;/api/work-orders/&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; context.Request.Url.Path.EndsWith(&quot;/progress&quot;, StringComparison.OrdinalIgnoreCase))">
            <!-- The work-order ID is not a customer ID. Forward the validated identity so the backend can enforce ownership. -->
            <set-header name="X-Customer-Id" exists-action="override">
              <value>@(((Jwt)context.Variables[&quot;customer-jwt&quot;]).Claims[&quot;customer_id&quot;][0])</value>
            </set-header>
          </when>
        </choose>
      </otherwise>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
