<policies>
  <inbound>
    <base />
    <set-variable name="correlation-id" value="@{
        Guid id;
        return Guid.TryParse(context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-Id&quot;, &quot;&quot;), out id) ? id.ToString() : Guid.NewGuid().ToString();
    }" />
    <set-header name="X-Correlation-Id" exists-action="override">
      <value>@((string)context.Variables[&quot;correlation-id&quot;])</value>
    </set-header>
    <set-header name="X-Customer-Id" exists-action="delete" />
    <choose>
      <when condition="@(context.Request.Method == &quot;OPTIONS&quot;)">
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="X-Correlation-Id" exists-action="override"><value>@((string)context.Variables[&quot;correlation-id&quot;])</value></set-header>
          <set-header name="Access-Control-Allow-Origin" exists-action="override"><value>*</value></set-header>
          <set-header name="Access-Control-Allow-Methods" exists-action="override"><value>GET, POST, PUT, PATCH, DELETE, OPTIONS</value></set-header>
          <set-header name="Access-Control-Allow-Headers" exists-action="override"><value>Authorization, Content-Type, X-Correlation-Id</value></set-header>
        </return-response>
      </when>
    </choose>
    <choose>
      <when condition="@(!context.Request.Method.Equals(&quot;GET&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; !context.Request.Method.Equals(&quot;HEAD&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; !context.Request.Method.Equals(&quot;OPTIONS&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; !context.Request.OriginalUrl.Path.Equals(&quot;/api/v1/identity-access/auth/login&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; string.Equals(&quot;{{catcar-work-order-mutations-paused}}&quot;, &quot;true&quot;, StringComparison.OrdinalIgnoreCase) &amp;&amp; System.Text.RegularExpressions.Regex.IsMatch(context.Request.OriginalUrl.Path, &quot;^/api/v1(?:/|$)&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase))">
        <return-response>
          <set-status code="503" reason="Service Unavailable" />
          <set-header name="X-Correlation-Id" exists-action="override"><value>@((string)context.Variables[&quot;correlation-id&quot;])</value></set-header>
          <set-header name="Retry-After" exists-action="override"><value>60</value></set-header>
          <set-body>API mutations are temporarily paused.</set-body>
        </return-response>
      </when>
    </choose>
    <choose>
      <when condition="@(context.Request.Method == &quot;POST&quot; &amp;&amp; context.Request.OriginalUrl.Path.Equals(&quot;/api/auth/customer&quot;, StringComparison.OrdinalIgnoreCase))">
        <rate-limit-by-key calls="5" renewal-period="60" counter-key="@(&quot;customer-auth:&quot; + context.Request.IpAddress)" />
        <set-backend-service backend-id="catcar-auth-function" />
        <rewrite-uri template="/api/auth/customer" copy-unmatched-params="true" />
      </when>
      <when condition="@(context.Request.Method == &quot;POST&quot; &amp;&amp; context.Request.OriginalUrl.Path.Equals(&quot;/api/v1/identity-access/auth/login&quot;, StringComparison.OrdinalIgnoreCase))">
        <rate-limit-by-key calls="5" renewal-period="60" counter-key="@(&quot;admin-login:&quot; + context.Request.IpAddress)" />
        <set-backend-service backend-id="catcar-api-aks" />
        <rewrite-uri template="/api/v1/identity-access/auth/login" copy-unmatched-params="true" />
      </when>
      <when condition="@(context.Request.Method == &quot;GET&quot; &amp;&amp; (context.Request.OriginalUrl.Path.Equals(&quot;/api/health/live&quot;, StringComparison.OrdinalIgnoreCase) || context.Request.OriginalUrl.Path.Equals(&quot;/api/health/ready&quot;, StringComparison.OrdinalIgnoreCase)))">
        <set-backend-service backend-id="catcar-api-aks" />
        <rewrite-uri template="@(context.Request.OriginalUrl.Path.Substring(4))" copy-unmatched-params="true" />
      </when>
      <when condition="@((context.Request.Method == &quot;GET&quot; &amp;&amp; System.Text.RegularExpressions.Regex.IsMatch(context.Request.OriginalUrl.Path, &quot;^/api/v1/communication/approval-links/[^/]+$&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)) || (context.Request.Method == &quot;POST&quot; &amp;&amp; System.Text.RegularExpressions.Regex.IsMatch(context.Request.OriginalUrl.Path, &quot;^/api/v1/communication/approval-links/[^/]+/decision$&quot;, System.Text.RegularExpressions.RegexOptions.IgnoreCase)))">
        <rate-limit-by-key calls="30" renewal-period="60" counter-key="@(&quot;approval:&quot; + context.Request.IpAddress)" />
        <set-backend-service backend-id="catcar-api-aks" />
        <rewrite-uri template="@(context.Request.OriginalUrl.Path)" copy-unmatched-params="true" />
      </when>
      <when condition="@(context.Request.Method == &quot;GET&quot; &amp;&amp; (context.Request.OriginalUrl.Path.Equals(&quot;/api/docs&quot;, StringComparison.OrdinalIgnoreCase) || context.Request.OriginalUrl.Path.Equals(&quot;/api/openapi/v1.json&quot;, StringComparison.OrdinalIgnoreCase)))">
        <set-backend-service backend-id="catcar-api-aks" />
        <rewrite-uri template="@(context.Request.OriginalUrl.Path.Substring(4))" copy-unmatched-params="true" />
      </when>
      <otherwise>
        <choose>
          <when condition="@{
              var authorization = context.Request.Headers.GetValueOrDefault(&quot;Authorization&quot;, &quot;&quot;);
              if (!authorization.StartsWith(&quot;Bearer &quot;, StringComparison.OrdinalIgnoreCase)) return false;
              var token = authorization.Substring(7).AsJwt();
              return token != null &amp;&amp; token.Audiences.Contains(&quot;CatCar.Api&quot;);
          }">
            <validate-jwt header-name="Authorization" require-scheme="Bearer" require-expiration-time="true" require-signed-tokens="true" failed-validation-httpcode="401" output-token-variable-name="catcar-jwt">
              <issuer-signing-keys><key>{{catcar-jwt-signing-key}}</key></issuer-signing-keys>
              <audiences><audience>CatCar.Api</audience></audiences>
              <issuers><issuer>CatCar</issuer></issuers>
              <required-claims>
                <claim name="role"><value>Customer</value></claim>
                <claim name="sub" />
                <claim name="customer_id" />
              </required-claims>
            </validate-jwt>
            <choose>
              <when condition="@{
                  var claims = ((Jwt)context.Variables[&quot;catcar-jwt&quot;]).Claims;
                  Guid customerId;
                  return !claims.ContainsKey(&quot;sub&quot;) || claims[&quot;sub&quot;].Length != 1 || string.IsNullOrWhiteSpace(claims[&quot;sub&quot;][0]) || !claims.ContainsKey(&quot;customer_id&quot;) || claims[&quot;customer_id&quot;].Length != 1 || !Guid.TryParse(claims[&quot;customer_id&quot;][0], out customerId);
              }">
                <return-response>
                  <set-status code="401" reason="Unauthorized" />
                  <set-header name="X-Correlation-Id" exists-action="override"><value>@((string)context.Variables[&quot;correlation-id&quot;])</value></set-header>
                </return-response>
              </when>
            </choose>
            <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(&quot;customer:&quot; + ((Jwt)context.Variables[&quot;catcar-jwt&quot;]).Claims[&quot;sub&quot;][0])" />
            <set-header name="X-Customer-Id" exists-action="override"><value>@(((Jwt)context.Variables[&quot;catcar-jwt&quot;]).Claims[&quot;customer_id&quot;][0])</value></set-header>
          </when>
          <otherwise>
            <validate-jwt header-name="Authorization" require-scheme="Bearer" require-expiration-time="true" require-signed-tokens="true" failed-validation-httpcode="401" output-token-variable-name="catcar-jwt">
              <issuer-signing-keys><key>{{catcar-admin-jwt-secret}}</key></issuer-signing-keys>
              <audiences><audience>CatCar.AdminApi</audience></audiences>
              <issuers><issuer>CatCar</issuer></issuers>
              <required-claims>
                <claim name="role" match="any"><value>Administrador</value><value>Tecnico</value><value>Recepcionista</value></claim>
                <claim name="sub" />
              </required-claims>
            </validate-jwt>
            <choose>
              <when condition="@(!((Jwt)context.Variables[&quot;catcar-jwt&quot;]).Claims.ContainsKey(&quot;sub&quot;) || ((Jwt)context.Variables[&quot;catcar-jwt&quot;]).Claims[&quot;sub&quot;].Length != 1 || string.IsNullOrWhiteSpace(((Jwt)context.Variables[&quot;catcar-jwt&quot;]).Claims[&quot;sub&quot;][0]))">
                <return-response>
                  <set-status code="401" reason="Unauthorized" />
                  <set-header name="X-Correlation-Id" exists-action="override"><value>@((string)context.Variables[&quot;correlation-id&quot;])</value></set-header>
                </return-response>
              </when>
            </choose>
            <rate-limit-by-key calls="120" renewal-period="60" counter-key="@(&quot;admin:&quot; + ((Jwt)context.Variables[&quot;catcar-jwt&quot;]).Claims[&quot;sub&quot;][0])" />
          </otherwise>
        </choose>
        <set-backend-service backend-id="catcar-api-aks" />
        <rewrite-uri template="@(context.Request.OriginalUrl.Path)" copy-unmatched-params="true" />
      </otherwise>
    </choose>
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-Id" exists-action="override"><value>@((string)context.Variables[&quot;correlation-id&quot;])</value></set-header>
  </outbound>
  <on-error>
    <base />
    <set-header name="X-Correlation-Id" exists-action="override"><value>@(context.Variables.GetValueOrDefault&lt;string&gt;(&quot;correlation-id&quot;, context.RequestId.ToString()))</value></set-header>
  </on-error>
</policies>
